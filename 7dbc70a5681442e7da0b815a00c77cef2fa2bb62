              },
              "replacement": "    if (cpi-\u003eppi-\u003elap_enabled) {\n      // When LAP is enabled, the stats buffer is used as a linear buffer.\n      // Set stats_in_end to the end of buffer to avoid infinite grow and out\n      // of boundary.\n      if (twopass-\u003estats_buf_ctx-\u003estats_in_end \u003e\n          twopass-\u003estats_buf_ctx-\u003estats_in_buf_end) {\n        twopass-\u003estats_buf_ctx-\u003estats_in_end \u003d\n            twopass-\u003estats_buf_ctx-\u003estats_in_buf_end;\n      }\n    } else {\n      // In the case of two pass without LAP, first pass uses a circular buffer.\n      if (twopass-\u003estats_buf_ctx-\u003estats_in_end \u003e\u003d\n          twopass-\u003estats_buf_ctx-\u003estats_in_buf_end) {\n        twopass-\u003estats_buf_ctx-\u003estats_in_end \u003d\n            twopass-\u003estats_buf_ctx-\u003estats_in_start;\n      }\n"
