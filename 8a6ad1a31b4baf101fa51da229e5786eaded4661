      "writtenOn": "2026-03-12T00:43:44Z",
      "side": 1,
      "message": "`this_yrd` is declared and initialized to `INT64_MAX` here.",
      "revId": "8a6ad1a31b4baf101fa51da229e5786eaded4661",
      "serverId": "e5514cf8-2d6e-3e29-adb4-24cd6dde4bf0"
