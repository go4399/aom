      "writtenOn": "2025-03-21T23:45:35Z",
      "side": 1,
      "message": "Optional: We may want to allow these two metadata OBUs to be layer-specific because of our CWG-F006 proposal.",
      "revId": "9182de0a11cf28074759cc6bf6c34971916d56ab",
      "serverId": "e5514cf8-2d6e-3e29-adb4-24cd6dde4bf0"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "82ca528a_9ad5164d",
        "filename": "aom/src/aom_image.c",
        "patchSetId": 8
      },
      "lineNbr": 391,
      "author": {
        "id": 26789
      },
      "writtenOn": "2025-03-24T14:41:20Z",
      "side": 1,
      "message": "Do you think we should make this change now, or wait for the spec to be updated?",
      "parentUuid": "f518c98f_69395f4e",
      "revId": "9182de0a11cf28074759cc6bf6c34971916d56ab",
      "serverId": "e5514cf8-2d6e-3e29-adb4-24cd6dde4bf0"
