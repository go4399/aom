      "writtenOn": "2026-02-26T18:33:00Z",
      "side": 1,
      "message": "hmm, don\u0027t we want to cap the value in the range of int32_t?",
      "parentUuid": "cdf3de25_e6dcab31",
      "revId": "ed3353fc7d0c3ef7c18f0a4bf2a386a9c1874bce",
      "serverId": "e5514cf8-2d6e-3e29-adb4-24cd6dde4bf0"
