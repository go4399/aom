      "message": "Just for reference: libaom v3.2.0 also has a memory leak in addition to this bug. The following patch fixes both of them:\n\n```\ndiff --git a/av1/encoder/encoder.c b/av1/encoder/encoder.c\nindex 6b40ea052c..f42ee21a56 100644\n--- a/av1/encoder/encoder.c\n+++ b/av1/encoder/encoder.c\n@@ -1584,9 +1584,7 @@ void av1_remove_compressor(AV1_COMP *cpi) {\n     av1_loop_filter_dealloc(\u0026mt_info-\u003elf_row_sync);\n     av1_cdef_mt_dealloc(\u0026mt_info-\u003ecdef_sync);\n #if !CONFIG_REALTIME_ONLY\n-    int num_lr_workers \u003d\n-        av1_get_num_mod_workers_for_alloc(\u0026cpi-\u003eppi-\u003ep_mt_info, MOD_LR);\n-    av1_loop_restoration_dealloc(\u0026mt_info-\u003elr_row_sync, num_lr_workers);\n+    av1_loop_restoration_dealloc(\u0026mt_info-\u003elr_row_sync, mt_info-\u003elr_row_sync.num_workers);\n     av1_gm_dealloc(\u0026mt_info-\u003egm_sync);\n     av1_tf_mt_dealloc(\u0026mt_info-\u003etf_sync);\n #endif\ndiff --git a/av1/encoder/ethread.c b/av1/encoder/ethread.c\nindex 25ecee94c8..b27401763b 100644\n--- a/av1/encoder/ethread.c\n+++ b/av1/encoder/ethread.c\n@@ -570,8 +570,7 @@ void av1_init_lr_mt_buffers(AV1_COMP *cpi) {\n   AV1_COMMON *const cm \u003d \u0026cpi-\u003ecommon;\n   AV1LrSync *lr_sync \u003d \u0026cpi-\u003emt_info.lr_row_sync;\n   if (lr_sync-\u003esync_range) {\n-    int num_lr_workers \u003d\n-        av1_get_num_mod_workers_for_alloc(\u0026cpi-\u003eppi-\u003ep_mt_info, MOD_LR);\n+    int num_lr_workers \u003d lr_sync-\u003enum_workers;\n #if CONFIG_FRAME_PARALLEL_ENCODE\n     if (cpi-\u003eppi-\u003egf_group.frame_parallel_level[cpi-\u003egf_frame_index] \u003e 0)\n       return;\n```",
