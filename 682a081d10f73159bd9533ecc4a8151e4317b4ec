mm0, zmm0, zmm2\n 1      3     1.00                        vextracti32x4\txmm2, zmm0, 3\n 1      1     0.33                        vpaddq\txmm0, xmm0, xmm2\n 1      1     1.00                        vpshufd\txmm2, xmm0, 238\n 1      1     0.33                        vpaddq\txmm0, xmm0, xmm2\n 1      2     1.00                        vmovd\tecx, xmm0\n 1      3     1.00                        vextracti32x4\txmm0, zmm3, 3\n 1      1     0.33                        vpaddq\txmm0, xmm3, xmm0\n 1      1     1.00                        vpshufd\txmm2, xmm0, 238\n 1      1     0.33                        vpaddq\txmm0, xmm0, xmm2\n 1      3     1.00                        vextracti32x4\txmm2, zmm1, 3\n 1      1     0.33                        vpaddq\txmm1, xmm1, xmm2\n 1      1     1.00                        vpshufd\txmm2, xmm1, 238\n 1      1     0.33                        vpaddq\txmm1, xmm1, xmm2\n 1      1     1.00                        vpunpckldq\txmm0, xmm1, xmm0\n 2      2     2.00                        vpinsrd\txmm0, xmm0, eax, 2\n 2      2     2.00                        vpinsrd\txmm0, xmm0, ecx, 3\n 2      1     1.00           *            vmovdqu\txmmword ptr [r8], xmm0\n```",
